# Required local secret files (never commit these files):
# ./secrets/kafka_broker_password.txt
# ./secrets/kafka_admin_password.txt
# ./secrets/kafka_client_password.txt
# ./secrets/kafka_twin_password.txt
# ./secrets/kafka_brain_password.txt
# ./secrets/postgres_password.txt

# Generate hexadecimal Kafka passwords with:
# openssl rand -hex 32
# Key rotation (vault/rotate_keys.py): one trigger URL per service
GUARDIAN_ROTATION_URL=
TWIN_ROTATION_URL=
BRAIN_ROTATION_URL=
