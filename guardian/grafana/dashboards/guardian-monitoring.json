          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  sensor_id,\n  score,\n  CASE WHEN is_anomaly THEN 'anomaly' ELSE NULL END AS label,\n  is_anomaly\nFROM public.model_outputs\nWHERE sensor_id = ANY(ARRAY[${sensor_id:sqlstring}]::text[])\n  AND window_end BETWEEN $__timeFrom() AND $__timeTo()\n  AND (('${anomaly}' = 'all') OR ('${anomaly}' = 'yes' AND is_anomaly) OR ('${anomaly}' = 'no' AND NOT is_anomaly))\nORDER BY id DESC\nLIMIT 100;",
          "refId": "A"
        }
