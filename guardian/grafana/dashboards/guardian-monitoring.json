          "rawQuery": true,
          "rawSql": "SELECT CASE WHEN COUNT(*) = 0 THEN 0\n            ELSE ROUND(100.0 * COUNT(*) FILTER (WHERE is_anomaly) / COUNT(*), 1)\n       END AS anomaly_rate\nFROM public.model_outputs\nWHERE sensor_id = ANY(ARRAY[${sensor_id:sqlstring}]::text[])\n  AND window_end BETWEEN $__timeFrom() AND $__timeTo();",
          "refId": "A"
