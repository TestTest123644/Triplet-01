{
 "kafka_schema": {
  "$defs": {
   "ZoneLocation": {
    "additionalProperties": false,
    "properties": {
     "lat": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Lat"
     },
     "lon": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Lon"
     },
     "zone_id": {
      "title": "Zone Id",
      "type": "string"
     }
    },
    "required": [
     "zone_id"
    ],
    "title": "ZoneLocation",
    "type": "object"
   }
  },
  "additionalProperties": false,
  "properties": {
   "device_id": {
    "title": "Device Id",
    "type": "string"
   },
   "device_type": {
    "enum": [
     "traffic_camera",
     "water_level",
     "power_load",
     "air_quality",
     "emergency_call"
    ],
    "title": "Device Type",
    "type": "string"
   },
   "location": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "$ref": "#/$defs/ZoneLocation"
     }
    ],
    "title": "Location"
   },
   "reading_id": {
    "title": "Reading Id",
    "type": "string"
   },
   "seq": {
    "minimum": 0,
    "title": "Seq",
    "type": "integer"
   },
   "sig": {
    "title": "Sig",
    "type": "string"
   },
   "status": {
    "enum": [
     "ok",
     "isolated",
     "quarantined",
     "rolled_back",
     "modelled"
    ],
    "title": "Status",
    "type": "string"
   },
   "ts": {
    "title": "Ts",
    "type": "string"
   },
   "unit": {
    "title": "Unit",
    "type": "string"
   },
   "value": {
    "title": "Value",
    "type": "number"
   }
  },
  "required": [
   "reading_id",
   "device_id",
   "device_type",
   "ts",
   "seq",
   "value",
   "unit",
   "location",
   "status",
   "sig"
  ],
  "title": "TwinSensorReading",
  "type": "object"
 },
