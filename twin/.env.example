# Apache Kafka Configuration
# Broker address or comma-separated list (h1:p,h2:p,h3:p; use kafka:9092 in Docker)
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
# Outbound sensor telemetry topic (must already exist; Twin does not create topics)
KAFKA_TOPIC=twin.sensors
# Producer durability: 'all' (default, enable.idempotence=True), '1', or '0'
KAFKA_ACKS=all
# Number of retry attempts when probing Kafka broker availability
KAFKA_WAIT_RETRIES=30
# Probe Kafka before starting (set false if partner ACLs disallow cluster describe)
WAIT_FOR_KAFKA=true
# Message delivery timeout in ms before marking delivery failed
KAFKA_MESSAGE_TIMEOUT_MS=10000
# Security protocol: PLAINTEXT, SASL_PLAINTEXT, or SASL_SSL
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
# SASL mechanism: PLAIN, SCRAM-SHA-256, or SCRAM-SHA-512
KAFKA_SASL_MECHANISM=PLAIN
# Username for SASL authentication (required if protocol is SASL_*)
KAFKA_USERNAME=
# Literal password for SASL authentication
KAFKA_PASSWORD=
# Path to file holding SASL password (takes priority over KAFKA_PASSWORD)
KAFKA_PASSWORD_FILE=
# Path to CA certificate file (optional, only used when protocol is SASL_SSL)
KAFKA_SSL_CA_LOCATION=
# Address family: any (default), v4, or v6 (use v4 to silence IPv6 refused noise)
KAFKA_BROKER_ADDRESS_FAMILY=any

# Example: Connecting to the Guardian's Kafka cluster (SASL password generated via `openssl rand -hex 24`, 48 hex chars)
# KAFKA_BOOTSTRAP_SERVERS=localhost:29094,localhost:29095,localhost:29096
# KAFKA_SECURITY_PROTOCOL=SASL_PLAINTEXT
# KAFKA_SASL_MECHANISM=PLAIN
# KAFKA_USERNAME=twin_producer
# In container: /app/secrets/kafka_password
# KAFKA_PASSWORD_FILE=../secrets/kafka_password
# KAFKA_TOPIC=telemetry-ingest

# Scenario Runner Kafka Configuration (SASL Reader on Guardian / Partner Clusters)
# Scenario consumer security protocol: PLAINTEXT, SASL_PLAINTEXT, or SASL_SSL (falls back to KAFKA_SECURITY_PROTOCOL)
# SCENARIO_KAFKA_SECURITY_PROTOCOL=
# Scenario consumer SASL mechanism: PLAIN, SCRAM-SHA-256, or SCRAM-SHA-512 (falls back to KAFKA_SASL_MECHANISM)
# SCENARIO_KAFKA_SASL_MECHANISM=
# Scenario consumer SASL username (falls back to KAFKA_USERNAME)
# SCENARIO_KAFKA_USERNAME=
# Scenario consumer SASL password literal (falls back to KAFKA_PASSWORD)
# SCENARIO_KAFKA_PASSWORD=
# Path to scenario consumer password file (Docker secret style; wins over SCENARIO_KAFKA_PASSWORD)
# SCENARIO_KAFKA_PASSWORD_FILE=
# Path to CA certificate file for SASL_SSL (falls back to KAFKA_SSL_CA_LOCATION)
# SCENARIO_KAFKA_SSL_CA_LOCATION=
# Scenario consumer broker address family: any, v4, or v6 (falls back to KAFKA_BROKER_ADDRESS_FAMILY)
# SCENARIO_KAFKA_BROKER_ADDRESS_FAMILY=
# Scenario consumer group prefix (default: scenario-runner; group.id = <prefix>-<timestamp>)
# SCENARIO_KAFKA_GROUP_PREFIX=

# Partner Verdict Collector Configuration (Timeline Correlation for Guardian / Brain)
# Verdict topic to consume (required to run verdict collector)
# VERDICT_TOPIC=
# Target layer name for verdict log file and timeline lane: guardian (default) or brain
# VERDICT_LAYER=guardian
# Verdict consumer Kafka broker list (falls back to KAFKA_BOOTSTRAP_SERVERS)
# VERDICT_KAFKA_BOOTSTRAP_SERVERS=
# Verdict consumer security protocol: PLAINTEXT, SASL_PLAINTEXT, or SASL_SSL (falls back to KAFKA_SECURITY_PROTOCOL)
# VERDICT_KAFKA_SECURITY_PROTOCOL=
# Verdict consumer SASL mechanism: PLAIN, SCRAM-SHA-256, or SCRAM-SHA-512 (falls back to KAFKA_SASL_MECHANISM)
# VERDICT_KAFKA_SASL_MECHANISM=
# Verdict consumer SASL username (falls back to KAFKA_USERNAME)
# VERDICT_KAFKA_USERNAME=
# Verdict consumer SASL password literal (falls back to KAFKA_PASSWORD)
# VERDICT_KAFKA_PASSWORD=
# Path to verdict consumer password file (Docker secret style; wins over VERDICT_KAFKA_PASSWORD)
# VERDICT_KAFKA_PASSWORD_FILE=
# Path to CA certificate file for SASL_SSL (falls back to KAFKA_SSL_CA_LOCATION)
# VERDICT_KAFKA_SSL_CA_LOCATION=
# Verdict consumer broker address family: any, v4, or v6 (falls back to KAFKA_BROKER_ADDRESS_FAMILY)
# VERDICT_KAFKA_BROKER_ADDRESS_FAMILY=
# Verdict consumer group ID (default: twin-verdict-collector)
# VERDICT_GROUP_ID=
# Verdict consumer offset reset: latest (default) or earliest
# VERDICT_OFFSET_RESET=

# MCP Command Server Configuration (Port 8000)
# Host interface to bind MCP server
MCP_HOST=0.0.0.0
# HTTP port for MCP JSON-RPC (/sse, /messages/, /mcp)
MCP_PORT=8000
# Optional bearer tokens in format 'principal:token,principal:token'
MCP_AUTH_TOKENS=
# Path to file holding bearer tokens (takes priority over MCP_AUTH_TOKENS)
MCP_AUTH_TOKENS_FILE=
# Optional comma-separated allowed hosts; unset or '*' disables DNS rebinding checks
MCP_ALLOWED_HOSTS=

# Secrets and Dynamic Resolution
# Optional hook 'package.module:function' called as func(name) -> str | None
TWIN_SECRET_HOOK=
# Optional periodic background secret reload interval in seconds (unset = disabled)
TWIN_SECRET_RELOAD_SECONDS=

# Red Team Adversary REST API Configuration (Port 8100)
# Bind address for isolated Red Team REST server (0.0.0.0 in Docker)
RED_TEAM_HOST=127.0.0.1
# Dedicated port for Red Team attack control endpoints
RED_TEAM_PORT=8100
# Optional static bearer token; auto-generated on startup if unset
RED_TEAM_TOKEN=
# Path to persist generated token (default: next to ground_truth.db)
RED_TEAM_TOKEN_FILE=

# Simulation Engine and Storage
# Path to isolated SQLite ground truth ledger
GROUND_TRUTH_DB_PATH=ground_truth.db
# Path to persistent device Ed25519 keystore (mode 600)
KEYSTORE_PATH=device_keys.json
# PRNG seed for deterministic physics simulation
SIM_SEED=42
# Simulation clock multiplier (e.g. 20.0 for live scenario runs)
SIM_SPEED=1.0
# Optional RFC 3339 start timestamp to override auto-resumed clock
SIM_START_TIME=
# Set true to wipe readings, attacks, and runs on startup (preserves keystore)
RESET_LEDGER=false
# Maximum readings in broadcast cache (42 devices * 10 Hz * 120 s)
READING_CACHE_MAX=50400
# Maximum bounded capacity for fallback streaming sink buffer
SINK_MAX=10000

# Operations Console Configuration (Streamlit)
# HTTP URL for dashboard to reach Red Team REST API (port 8100)
TWIN_API_URL=http://localhost:8100
# URL for dashboard to TCP-probe MCP command server status
MCP_URL=http://localhost:8000
# Optional directory path containing partner JSON lines logs
TIMELINE_LOG_DIR=
# Set to 1 in automated test runs to disable auto-refresh loops
STREAMLIT_TESTING=0

# Triplet Network and Port Configuration
# Shared bridge network name (e.g. twin_network for Brain, shared-backend for Guardian)
TRIPLET_NETWORK=city_network
# Set to true when connecting to an existing external Docker network
TRIPLET_NETWORK_EXTERNAL=false
# Host directory mounted read-only to /app/secrets inside container
TWIN_SECRETS_DIR=../secrets
# Host port mapped to container port 8000 (MCP command server)
TWIN_MCP_HOST_PORT=8000
# Host port mapped to container port 8100 (Red Team REST API)
TWIN_RED_TEAM_HOST_PORT=8100
# Host port mapped to container port 8501 (Streamlit console)
TWIN_CONSOLE_HOST_PORT=8501

# HashiCorp Vault Configuration (Optional Key Synchronization)
# Vault cluster URL (e.g. https://<cluster>.hashicorp.cloud:8200; unset = disabled)
VAULT_ADDR=
# Vault namespace header (default: admin; empty string = no header)
VAULT_NAMESPACE=admin
# AppRole Role ID for authentication
VAULT_ROLE_ID=
# Path to Role ID file (e.g. ../secrets/vault_twin_role_id; in container: /app/secrets/vault_twin_role_id)
VAULT_ROLE_ID_FILE=
# AppRole Secret ID for authentication
VAULT_SECRET_ID=
# Path to Secret ID file (e.g. ../secrets/vault_twin_secret_id; in container: /app/secrets/vault_twin_secret_id)
VAULT_SECRET_ID_FILE=
# Path to custom CA bundle (unset = certifi or system default; verification never disabled)
VAULT_CACERT=
# Vault KV v2 mount point (default: secret)
VAULT_KV_MOUNT=secret
# Secret paths to synchronize from Vault KV v2
VAULT_TWIN_PATHS=comm/twin/guardian/private,comm/twin/brain/private,comm/guardian/twin/public,comm/brain/twin/public
# Refresh interval in seconds (default: 300; 0 disables background thread)
VAULT_REFRESH_SECONDS=300
# Note: Communication keys are fetched and kept fresh in memory but not yet used for any traffic encryption.
