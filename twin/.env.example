# Apache Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:19092  # Address of the Kafka broker (use kafka:9092 within Docker network)
KAFKA_TOPIC=twin.sensors                 # Outbound sensor telemetry topic (420 msgs/s)
KAFKA_WAIT_RETRIES=30                    # Number of retry attempts when probing Kafka broker availability
WAIT_FOR_KAFKA=true                      # Block simulation loop until Kafka broker is reachable (set false for testing)
KAFKA_MESSAGE_TIMEOUT_MS=10000           # Message delivery timeout in ms before marking delivery failed

# MCP Command Server Configuration (Strictly MCP JSON-RPC, Port 8000)
MCP_HOST=0.0.0.0                         # Host interface to bind MCP server
MCP_PORT=8000                            # HTTP/SSE port for Model Context Protocol JSON-RPC (/sse, /messages/)

# Red Team Adversary REST API Configuration (Dedicated Isolated Port 8100)
RED_TEAM_HOST=127.0.0.1                  # Bind address for isolated Red Team REST server (0.0.0.0 in Docker)
RED_TEAM_PORT=8100                       # Dedicated port for Red Team attack control endpoints
RED_TEAM_TOKEN=                          # Optional static bearer token; if unset, auto-generated on startup
RED_TEAM_TOKEN_FILE=                     # Path to persist generated token (default: next to ground_truth.db)

# Simulation Engine & Storage
GROUND_TRUTH_DB_PATH=ground_truth.db     # Path to the isolated SQLite ground truth ledger
KEYSTORE_PATH=device_keys.json           # Path to persistent device Ed25519 keystore (mode 600)
SIM_SEED=42                              # PRNG seed for deterministic physics simulation (keys managed by keystore)
SIM_START_TIME=                          # Optional RFC 3339 start timestamp to override auto-resumed clock
RESET_LEDGER=false                       # Set to true to wipe readings, attacks, and runs on startup (preserves devices & keystore)
READING_CACHE_MAX=50400                  # Maximum readings in the recent broadcast cache (42 devices * 10 Hz * 120 s)
SINK_MAX=10000                           # Maximum bounded capacity for the fallback streaming sink buffer

# Streamlit Operations Console
TWIN_API_URL=http://localhost:8100       # HTTP URL for the dashboard to reach Red Team REST API (port 8100)
STREAMLIT_TESTING=0                      # Set to 1 in automated test runs to disable auto-refresh loops
