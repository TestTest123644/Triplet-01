# Apache Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:19092  # Broker address or comma-separated list (h1:p,h2:p,h3:p; use kafka:9092 within Docker network)
KAFKA_TOPIC=twin.sensors                 # Outbound sensor telemetry topic (must already exist; Twin does not create topics)
KAFKA_ACKS=all                           # Producer durability: 'all' (default, enable.idempotence=True), '1', or '0'
KAFKA_WAIT_RETRIES=30                    # Number of retry attempts when probing Kafka broker availability
WAIT_FOR_KAFKA=true                      # Probe Kafka before starting (set false if partner ACLs disallow cluster describe)
KAFKA_MESSAGE_TIMEOUT_MS=10000           # Message delivery timeout in ms before marking delivery failed
KAFKA_SECURITY_PROTOCOL=PLAINTEXT        # Security protocol: PLAINTEXT, SASL_PLAINTEXT, or SASL_SSL
KAFKA_SASL_MECHANISM=PLAIN               # SASL mechanism: PLAIN, SCRAM-SHA-256, or SCRAM-SHA-512
KAFKA_USERNAME=                          # Username for SASL authentication (required if SASL_*)
KAFKA_PASSWORD=                          # Literal password for SASL authentication
KAFKA_PASSWORD_FILE=                     # Path to password file (Docker-secret style; takes precedence over KAFKA_PASSWORD)
KAFKA_SSL_CA_LOCATION=                   # Path to CA certificate file (optional, only used when protocol is SASL_SSL)
KAFKA_BROKER_ADDRESS_FAMILY=any          # Address family: any (default), v4, or v6 (use v4 to silence IPv6 refused noise)

# Example: Connecting to the Guardian's Kafka cluster
# KAFKA_BOOTSTRAP_SERVERS=localhost:29094,localhost:29095,localhost:29096
# KAFKA_SECURITY_PROTOCOL=SASL_PLAINTEXT
# KAFKA_SASL_MECHANISM=PLAIN
# KAFKA_USERNAME=twin
# KAFKA_PASSWORD_FILE=secrets/kafka_password
# KAFKA_TOPIC=telemetry-ingest

# MCP Command Server Configuration (Strictly MCP JSON-RPC, Port 8000)
MCP_HOST=0.0.0.0                         # Host interface to bind MCP server
MCP_PORT=8000                            # HTTP/SSE port for Model Context Protocol JSON-RPC (/sse, /messages/)
MCP_AUTH_TOKENS=                         # Optional bearer tokens ('brain:<tok>,guardian:<tok>,scenario:<tok>'). Recommended on LAN!
MCP_AUTH_TOKENS_FILE=                    # Path to file holding bearer tokens (takes priority over MCP_AUTH_TOKENS)
MCP_ALLOWED_HOSTS=                       # Optional comma-separated hosts; unset (default) or '*' disables DNS protection (open LAN)

# Secrets and Dynamic Resolution
TWIN_SECRET_HOOK=                        # Optional hook 'package.module:function' called as func(name) -> str | None
TWIN_SECRET_RELOAD_SECONDS=              # Optional periodic background secret reload interval in seconds (unset = disabled)

# Red Team Adversary REST API Configuration (Dedicated Isolated Port 8100)
RED_TEAM_HOST=127.0.0.1                  # Bind address for isolated Red Team REST server (0.0.0.0 in Docker)
RED_TEAM_PORT=8100                       # Dedicated port for Red Team attack control endpoints
RED_TEAM_TOKEN=                          # Optional static bearer token; if unset, auto-generated on startup
RED_TEAM_TOKEN_FILE=                     # Path to persist generated token (default: next to ground_truth.db)

# Simulation Engine & Storage
GROUND_TRUTH_DB_PATH=ground_truth.db     # Path to the isolated SQLite ground truth ledger
KEYSTORE_PATH=device_keys.json           # Path to persistent device Ed25519 keystore (mode 600)
SIM_SEED=42                              # PRNG seed for deterministic physics simulation (keys managed by keystore)
SIM_SPEED=1.0                            # Sim speed multiplier (e.g. 20.0 for live scenario testing)
SIM_START_TIME=                          # Optional RFC 3339 start timestamp to override auto-resumed clock
RESET_LEDGER=false                       # Set to true to wipe readings, attacks, and runs on startup (preserves devices & keystore)
READING_CACHE_MAX=50400                  # Maximum readings in the recent broadcast cache (42 devices * 10 Hz * 120 s)
SINK_MAX=10000                           # Maximum bounded capacity for the fallback streaming sink buffer

# Streamlit Operations Console
TWIN_API_URL=http://localhost:8100       # HTTP URL for the dashboard to reach Red Team REST API (port 8100)
MCP_URL=http://localhost:8000            # URL for dashboard to TCP-probe MCP command server status
TIMELINE_LOG_DIR=                        # Optional directory path containing partner JSON lines logs
STREAMLIT_TESTING=0                      # Set to 1 in automated test runs to disable auto-refresh loops

# Triplet Network Configuration
TRIPLET_NETWORK=city_network             # Shared bridge network name (e.g. twin_network for Brain, shared-backend for Guardian)

