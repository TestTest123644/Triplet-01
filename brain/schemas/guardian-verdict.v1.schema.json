{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GuardianVerdictV1",
  "type": "object",
  "properties": {
    "verdict_id": { "type": "string" },
    "reading_id": { "type": "string" },
    "sig_hash": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
    "device_id": { "type": "string" },
    "state": { "type": "string" },
    "trust": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "reasons": { "type": "array", "items": { "type": "string", "pattern": "^[A-Z_]+$" } },
    "issued_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "sig": { "type": "string" }
  },
  "required": ["verdict_id", "reading_id", "sig_hash", "device_id", "state", "reasons", "issued_at", "expires_at", "sig"],
  "additionalProperties": false
}
